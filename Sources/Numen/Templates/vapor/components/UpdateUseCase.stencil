import Vapor
import Fluent

struct {{ name }} {
    let repository: {{ repositoryName }}

    init(repository: {{ repositoryName }}) {
        self.repository = repository
    }

    func execute(id: UUID, input: {{ dtoName }}.Update, on db: Database) async throws -> {{ entityName }} {
        guard let model = try await repository.findById(id, on: db) else {
            throw Abort(.notFound, reason: "{{ entityName }} not found")
        }
{% for field in fields %}
        if let {{ field.name }} = input.{{ field.name }} {
            model.{{ field.name }} = {{ field.name }}
        }
{% endfor %}
        try await repository.save(model, on: db)
        return model
    }
}
