import Foundation

struct {{ name }} {
    let repository: {{ repositoryName }}

    init(repository: {{ repositoryName }}) {
        self.repository = repository
    }

    func execute(id: UUID, input: {{ dtoName }}.Update) async throws -> {{ entityName }}? {
        guard let existing = try await repository.findById(id) else { return nil }
        let updated = {{ entityName }}(
            id: existing.id{% for field in fields %},
            {{ field.name }}: input.{{ field.name }} ?? existing.{{ field.name }}{% endfor %}
        )
        try await repository.save(updated)
        return updated
    }
}
