import Foundation

enum {{ name }} {
    struct Create: Codable {
{% for field in fields %}
        let {{ field.name }}: {{ field.swiftType }}{% if field.optional %}?{% endif %}

{% endfor %}
{% if not hasFields %}
        // TODO: Add create fields
{% endif %}
        init(from request: Create{{ entityName }}Request) {
{% for field in fields %}
            self.{{ field.name }} = request.{{ field.name }}
{% endfor %}
{% if not hasFields %}
            // TODO: Map from request
{% endif %}
        }
    }

    struct Update: Codable {
{% for field in fields %}
        var {{ field.name }}: {{ field.swiftType }}?
{% endfor %}
{% if not hasFields %}
        // TODO: Add update fields
{% endif %}
        init(from request: Update{{ entityName }}Request) {
{% for field in fields %}
            self.{{ field.name }} = request.{{ field.name }}
{% endfor %}
{% if not hasFields %}
            // TODO: Map from request
{% endif %}
        }
    }

    struct Response: Codable {
        let id: UUID
{% for field in fields %}
        let {{ field.name }}: {{ field.swiftType }}{% if field.optional %}?{% endif %}

{% endfor %}
        init(from aggregate: {{ entityName }}) {
            self.id = aggregate.id
{% for field in fields %}
            self.{{ field.name }} = aggregate.{{ field.name }}
{% endfor %}
        }
    }
}
