import Foundation

{% if entityName %}
struct {{ name }} {
    let repository: {{ entityName }}Repository

    init(repository: {{ entityName }}Repository) {
        self.repository = repository
    }

    struct Input {
        let id: UUID
    }

    func execute(_ input: Input) async throws {
        guard let aggregate = try await repository.findById(input.id) else {
            throw UseCaseError.notFound("{{ entityName }} not found: \(input.id)")
        }
        // TODO: Call aggregate behavior method, e.g.:
        // try aggregate.performAction(...)
        try await repository.save(aggregate)
    }
}
{% else %}
struct {{ name }} {
    struct Input {}
    struct Output {}

    func execute(_ input: Input) async throws -> Output {
        // TODO: Implement use case
        return Output()
    }
}
{% endif %}
