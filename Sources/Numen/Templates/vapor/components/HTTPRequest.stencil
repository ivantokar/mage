import Vapor

struct Create{{ entityName }}Request: Content {
{% for field in fields %}
    let {{ field.name }}: {{ field.swiftType }}{% if field.optional %}?{% endif %}

{% endfor %}
{% if not hasFields %}
    // TODO: Add request fields
{% endif %}
}

struct Update{{ entityName }}Request: Content {
{% for field in fields %}
    var {{ field.name }}: {{ field.swiftType }}?
{% endfor %}
{% if not hasFields %}
    // TODO: Add request fields
{% endif %}
}
