import Vapor
import Fluent

struct {{ name }} {
    let repository: {{ repositoryName }}

    init(repository: {{ repositoryName }}) {
        self.repository = repository
    }

    func execute(id: UUID, on db: Database) async throws -> {{ entityName }} {
        guard let model = try await repository.findById(id, on: db) else {
            throw Abort(.notFound, reason: "{{ entityName }} not found")
        }
        return model
    }
}
