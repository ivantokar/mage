import Foundation

struct {{ name }}: Equatable, Hashable, Codable {
{% for field in fields %}
    let {{ field.name }}: {{ field.swiftType }}{% if field.optional %}?{% endif %}

{% endfor %}
{% if not hasFields %}
    let value: String

{% endif %}
    init({% if hasFields %}{% for field in fields %}{{ field.name }}: {{ field.swiftType }}{% if field.optional %}?{% endif %}{% if not forloop.last %}, {% endif %}{% endfor %}{% else %}_ value: String{% endif %}) throws {
{% if hasFields %}
{% for field in fields %}
        self.{{ field.name }} = {{ field.name }}
{% endfor %}
{% else %}
        guard !value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            throw Abort(.badRequest, reason: "{{ name }} value cannot be empty")
        }
        self.value = value
{% endif %}
    }
}
