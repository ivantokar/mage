import Vapor
import Fluent
{% if database == "postgres" %}
import FluentPostgresDriver
{% endif %}
{% if database == "mysql" %}
import FluentMySQLDriver
{% endif %}
{% if database == "sqlite" %}
import FluentSQLiteDriver
{% endif %}

public func configure(_ app: Application) async throws {
    // Encoder / decoder
    let encoder = JSONEncoder()
    encoder.dateEncodingStrategy = .iso8601
    let decoder = JSONDecoder()
    decoder.dateDecodingStrategy = .iso8601
    ContentConfiguration.global.use(encoder: encoder, for: .json)
    ContentConfiguration.global.use(decoder: decoder, for: .json)

    // Database
{% if database == "postgres" %}
    app.databases.use(
        .postgres(configuration: .init(
            hostname: Environment.get("DB_HOST") ?? "localhost",
            port: Int(Environment.get("DB_PORT") ?? "5432") ?? 5432,
            username: Environment.get("DB_USER") ?? "vapor",
            password: Environment.get("DB_PASSWORD") ?? "vapor",
            database: Environment.get("DB_NAME") ?? "{{ projectName }}"
        )),
        as: .psql
    )
{% endif %}
{% if database == "mysql" %}
    app.databases.use(
        .mysql(
            hostname: Environment.get("DB_HOST") ?? "localhost",
            port: Int(Environment.get("DB_PORT") ?? "3306") ?? 3306,
            username: Environment.get("DB_USER") ?? "vapor",
            password: Environment.get("DB_PASSWORD") ?? "vapor",
            database: Environment.get("DB_NAME") ?? "{{ projectName }}"
        ),
        as: .mysql
    )
{% endif %}
{% if database == "sqlite" %}
    app.databases.use(.sqlite(.file("db.sqlite")), as: .sqlite)
{% endif %}

    // Migrations
    // app.migrations.add(CreateUser())

    // Routes
    try routes(app)
}
