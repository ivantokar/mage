import Fluent

struct {{ name }}: AsyncMigration {
    func prepare(on database: Database) async throws {
        try await database.schema("{{ entityName | snakeCase | pluralize }}")
            .id()
{% for field in fields %}
            .field("{{ field.name | snakeCase }}", .{{ field.swiftType | lowercase }}{% if not field.optional %}, .required{% endif %})
{% endfor %}
            .field("created_at", .datetime)
            .field("updated_at", .datetime)
            .create()
    }

    func revert(on database: Database) async throws {
        try await database.schema("{{ entityName | snakeCase | pluralize }}").delete()
    }
}
