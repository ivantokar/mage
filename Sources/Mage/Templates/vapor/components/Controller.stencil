import Vapor

struct {{ name }}: RouteCollection {
    func boot(routes: RoutesBuilder) throws {
        let items = routes.grouped("{{ entityName | snakeCase | pluralize }}")
        items.get(use: index)
        items.post(use: create)
        items.group(":id") { item in
            item.get(use: show)
            item.put(use: update)
            item.delete(use: delete)
        }
    }

    func index(req: Request) async throws -> [{{ entityName }}Response] {
        let repo = Fluent{{ entityName }}Repository(db: req.db)
        let useCase = GetAll{{ entityName | pluralize }}UseCase(repository: repo)
        return try await useCase.execute().map { {{ entityName }}Response(from: $0) }
    }

    func create(req: Request) async throws -> {{ entityName }}Response {
        let input = try req.content.decode(Create{{ entityName }}Request.self)
        let dto = {{ entityName }}DTO.Create(from: input)
        let repo = Fluent{{ entityName }}Repository(db: req.db)
        let useCase = Create{{ entityName }}UseCase(repository: repo)
        let result = try await useCase.execute(dto)
        return {{ entityName }}Response(from: result)
    }

    func show(req: Request) async throws -> {{ entityName }}Response {
        guard let id = req.parameters.get("id", as: UUID.self) else {
            throw Abort(.badRequest, reason: "Invalid ID")
        }
        let repo = Fluent{{ entityName }}Repository(db: req.db)
        let useCase = Get{{ entityName }}ByIdUseCase(repository: repo)
        guard let result = try await useCase.execute(id: id) else {
            throw Abort(.notFound)
        }
        return {{ entityName }}Response(from: result)
    }

    func update(req: Request) async throws -> {{ entityName }}Response {
        guard let id = req.parameters.get("id", as: UUID.self) else {
            throw Abort(.badRequest, reason: "Invalid ID")
        }
        let input = try req.content.decode(Update{{ entityName }}Request.self)
        let dto = {{ entityName }}DTO.Update(from: input)
        let repo = Fluent{{ entityName }}Repository(db: req.db)
        let useCase = Update{{ entityName }}UseCase(repository: repo)
        guard let result = try await useCase.execute(id: id, input: dto) else {
            throw Abort(.notFound)
        }
        return {{ entityName }}Response(from: result)
    }

    func delete(req: Request) async throws -> HTTPStatus {
        guard let id = req.parameters.get("id", as: UUID.self) else {
            throw Abort(.badRequest, reason: "Invalid ID")
        }
        let repo = Fluent{{ entityName }}Repository(db: req.db)
        let useCase = Delete{{ entityName }}UseCase(repository: repo)
        try await useCase.execute(id: id)
        return .noContent
    }
}
