import Foundation

struct {{ name }} {
    let repository: {{ repositoryName }}

    init(repository: {{ repositoryName }}) {
        self.repository = repository
    }

    func execute(_ input: {{ dtoName }}.Create) async throws -> {{ entityName }} {
        let aggregate = {{ entityName }}(
{% for field in fields %}
            {{ field.name }}: input.{{ field.name }}{% if not forloop.last %},{% endif %}

{% endfor %}
        )
        try await repository.save(aggregate)
        return aggregate
    }
}
