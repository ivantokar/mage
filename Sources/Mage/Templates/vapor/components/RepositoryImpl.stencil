import Foundation
import Fluent

struct {{ implName }}: {{ protocolName }} {
    let db: Database

    func findById(_ id: UUID) async throws -> {{ entityName }}? {
        try await {{ entityName }}Model.find(id, on: db).map { $0.toDomain() }
    }

    func findAll() async throws -> [{{ entityName }}] {
        try await {{ entityName }}Model.query(on: db).all().map { $0.toDomain() }
    }

    func save(_ aggregate: {{ entityName }}) async throws {
        if let existing = try await {{ entityName }}Model.find(aggregate.id, on: db) {
{% for field in fields %}
            existing.{{ field.name }} = aggregate.{{ field.name }}
{% endfor %}
            try await existing.save(on: db)
        } else {
            let model = {{ entityName }}Model(aggregate)
            try await model.save(on: db)
        }
    }

    func delete(_ id: UUID) async throws {
        if let model = try await {{ entityName }}Model.find(id, on: db) {
            try await model.delete(on: db)
        }
    }
}
