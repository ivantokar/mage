import Vapor
import Fluent

struct AuthController: RouteCollection {
    func boot(routes: RoutesBuilder) throws {
        let auth = routes.grouped("auth")
        auth.post("register", use: register)

        let protected = auth.grouped(User.authenticator())
        protected.post("login", use: login)

        let tokenProtected = auth.grouped(UserToken.authenticator())
        tokenProtected.delete("logout", use: logout)
        tokenProtected.get("me", use: me)
    }

    func register(req: Request) async throws -> HTTPStatus {
        try RegisterRequest.validate(content: req)
        let input = try req.content.decode(RegisterRequest.self)

        guard try await User.query(on: req.db).filter(\.$email == input.email).first() == nil else {
            throw Abort(.conflict, reason: "Email already registered")
        }

        let hash = try Bcrypt.hash(input.password)
        let user = User(email: input.email, passwordHash: hash, name: input.name)
        try await user.save(on: req.db)
        return .created
    }

    func login(req: Request) async throws -> TokenResponse {
        let user = try req.auth.require(User.self)
        let token = try UserToken.generate(for: user)
        try await token.save(on: req.db)
        return TokenResponse(token: token.value)
    }

    func logout(req: Request) async throws -> HTTPStatus {
        let user = try req.auth.require(User.self)
        try await UserToken.query(on: req.db)
            .filter(\.$user.$id == user.requireID())
            .delete()
        req.auth.logout(User.self)
        return .ok
    }

    func me(req: Request) async throws -> UserResponse {
        let user = try req.auth.require(User.self)
        return UserResponse(id: user.id, email: user.email, name: user.name)
    }
}

struct RegisterRequest: Content, Validatable {
    let email: String
    let password: String
    let name: String

    static func validations(_ validations: inout Validations) {
        validations.add("email", as: String.self, is: .email)
        validations.add("password", as: String.self, is: .count(8...))
        validations.add("name", as: String.self, is: !.empty)
    }
}

struct TokenResponse: Content {
    let token: String
}

struct UserResponse: Content {
    let id: UUID?
    let email: String
    let name: String
}
